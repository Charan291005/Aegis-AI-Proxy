# ==============================================================================
# Aegis Zero-Trust MCP Gateway - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and populate the values for local development.
# In production, inject these via secret management (e.g., Vault, AWS Secrets Manager).

# Gateway Authentication Secret
# Bearer token required by all client LLM agents to communicate with the proxy.
AEGIS_GATEWAY_TOKEN=aegis_super_secret_bearer_token_2026_demo

# Server Environment & Port
AEGIS_ENV=development
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
LOG_LEVEL=INFO

# Supabase RBAC Configuration
# Credentials for authenticating and authorizing session roles against PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_supabase_key
SUPABASE_SERVICE_ROLE_KEY=eyJhGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key

# Upstream MCP Server (Reverse Proxy target)
# Optional: Set this to forward requests to an external MCP server (e.g., http://localhost:8080/mcp)
# If left empty, Aegis operates in standalone mode with registered local tools.
UPSTREAM_MCP_URL=
UPSTREAM_TIMEOUT_SECONDS=30.0

# Rate Limiting & DoS Protection
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=120

# Security & DLP Policies
ENABLE_PII_REDACTION=true
ENABLE_SECRETS_REDACTION=true
ENABLE_INJECTION_SHIELD=true
ALLOWED_ORIGINS=*
